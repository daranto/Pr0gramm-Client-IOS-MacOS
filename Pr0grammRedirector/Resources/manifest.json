{
  "content_scripts": [
    {
      "js": ["content.js"],
      "matches": ["https://pr0gramm.com/*", "https://pr0.app/*"],
      "run_at": "document_start"
    }
  ],
  "default_locale": "en",
  "description": "Öffnet Links vom Pr0 direkt in der APP.",
  "icons": {
    "48": "images/icon-48.png",
    "96": "images/icon-96.png",
    "128": "images/icon-128.png",
    "256": "images/icon-256.png",
    "512": "images/icon-512.png"
  },
  "manifest_version": 3,
  "name": "Open in Pr0gramm App",
  "permissions": [],
  "version": "1.0"
}
